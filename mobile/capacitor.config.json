{
  "appId": "com.bloppit.app",
  "appName": "Bloppit",
  "webDir": "www",
  "ios": {
    "contentInset": "never",
    "backgroundColor": "#E4EAF2",
    "preferredContentMode": "mobile",
    "limitsNavigationsToAppBoundDomains": false
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 600,
      "launchAutoHide": true,
      "backgroundColor": "#0369BD",
      "showSpinner": false
    }
  }
}
