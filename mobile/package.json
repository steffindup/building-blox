{
  "name": "bloppit-app",
  "private": true,
  "type": "module",
  "description": "Bloppit for the App Store: the web app in public/build, wrapped with Capacitor.",
  "scripts": {
    "build": "node scripts/build-www.mjs",
    "sync": "npm run build && npx cap sync ios",
    "icons": "npx capacitor-assets generate --ios"
  },
  "dependencies": {
    "@capacitor/core": "^8.5.3",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.5.3",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.3",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/lilita-one": "^5.3.0",
    "@fontsource/nunito": "^5.3.0",
    "three": "0.128.0"
  }
}
