{
  "name": "building-blox",
  "private": true,
  "type": "module",
  "dependencies": {
    "@netlify/blobs": "^11.1.4"
  },
  "devDependencies": {
    "@fontsource/lilita-one": "^5.2.5",
    "@fontsource/nunito": "^5.2.5",
    "@netlify/functions": "^6.0.2",
    "playwright": "^1.56.0",
    "three": "^0.128.0"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "test:server": "node --test tests/server.test.mjs",
    "dev": "node tests/devserver.mjs",
    "build:www": "cd mobile && npm run build",
    "build:challenger": "node scripts/build-challenger.mjs",
    "test:challenger": "node --test tests/challenger.test.mjs tests/challenger-browser.test.mjs",
    "dev:challenger": "node scripts/dev-challenger.mjs",
    "test:full": "node scripts/build-challenger-mobile.mjs && node --test tests/full-challenger.test.mjs",
    "test:parity": "node scripts/test-parity.mjs"
  }
